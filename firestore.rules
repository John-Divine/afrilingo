rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    // Private User Profiles & Progress
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      match /progress/{lessonId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(lessonId);
        allow delete: if isOwner(userId);
      }
    }

    // Public Learner Directory for connecting with others & Leaderboard
    match /community_learners/{learnerId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(learnerId) && isValidId(learnerId);
      allow delete: if isOwner(learnerId);
    }

    // Community Wisdom Posts & Social Interactions
    match /community_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
